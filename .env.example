# Copy this file to .env.local and fill in your Supabase project's values
# (Project Settings -> API in the Supabase dashboard).
#
# VITE_SUPABASE_ANON_KEY is safe to expose to the browser — it's the public
# key. Access is controlled by the Row Level Security policies in
# supabase/migrations/0001_init.sql, not by keeping this key secret.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Shared access code shown on first visit — a soft deterrent to keep casual
# visitors out, NOT real authentication (it's a client-side check; see
# src/components/AccessGate.tsx for why).
VITE_ACCESS_CODE=WCH2026
